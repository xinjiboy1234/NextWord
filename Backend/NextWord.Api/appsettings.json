{
  "Database": {
    "Provider": "PostgreSql"
  },
  "Cache": {
    "Provider": "Memory",
    "Redis": {
      "ConnectionString": "localhost:6379",
      "InstanceName": "nextword:"
    }
  },
  "ConnectionStrings": {
    "PostgreSql": "Host=localhost;Port=5432;Database=nextword;Username=nextword;Password=nextword",
    "Redis": "localhost:6379"
  },
  "Llm": {
    "SentenceRating": {
      "ExplanationLanguage": "zh-CN"
    },
    "OpenAI": {
      "Enabled": false,
      "Model": "gpt-4o-mini",
      "ApiKeyEnvironmentVariable": "OPENAI_API_KEY"
    }
  },
  "Auth": {
    "JwtSecret": "nextword-dev-jwt-secret-change-in-production-32chars",
    "Issuer": "NextWord",
    "Audience": "NextWord",
    "ExpirationDays": 7
  },
  "ScoreMapping": {
    "CefrBands": [
      { "Min": 0, "Max": 20, "Label": "A1" },
      { "Min": 20, "Max": 35, "Label": "A2" },
      { "Min": 35, "Max": 50, "Label": "B1" },
      { "Min": 50, "Max": 70, "Label": "B2" },
      { "Min": 70, "Max": 85, "Label": "C1" },
      { "Min": 85, "Max": 100, "Label": "C2" }
    ],
    "DifficultyBuckets": [
      { "Min": 0, "Max": 35, "Label": "Basic" },
      { "Min": 35, "Max": 70, "Label": "Intermediate" },
      { "Min": 70, "Max": 101, "Label": "Advanced" }
    ]
  },
  "ChallengeThresholds": {
    "VocabAccuracyMin": 0.60,
    "WritingScoreMin": 53,
    "ReadingScoreMin": 100,
    "UpgradeDelta": 5
  },
  "Search": {
    "Enabled": true,
    "MaxResults": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
