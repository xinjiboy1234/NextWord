{
  "Database": {
    "Provider": "Sqlite"
  },
  "Cache": {
    "Provider": "Memory",
    "Redis": {
      "ConnectionString": "localhost:6379",
      "InstanceName": "nextword:"
    }
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=nextword-dev.db",
    "PostgreSql": "Host=localhost;Port=5432;Database=nextword;Username=nextword;Password=nextword",
    "Redis": "localhost:6379"
  },
  "Llm": {
    "OpenAI": {
      "Enabled": false,
      "Model": "gpt-4o-mini",
      "ApiKeyEnvironmentVariable": "OPENAI_API_KEY"
    }
  },
  "Auth": {
    "JwtSecret": "nextword-dev-jwt-secret-change-in-production-32chars",
    "Issuer": "NextWord",
    "Audience": "NextWord",
    "ExpirationDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
